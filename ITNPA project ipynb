    "import pandas as pd\n",
    "import re\n",
    "\n",
    "df = pd.read_json(\"research_abstracts.json\")\n",
    "\n",
    "# Remove missing and duplicate records\n",
    "df = df.dropna(subset=[\"Abstract\", \"Label\"])\n",
    "df = df.drop_duplicates(subset=[\"Abstract\", \"Label\"]).copy()\n",
    "\n",
    "# Clean the text\n",
    "def clean(text):\n",
    "    text = str(text).lower()\n",
    "    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n",
    "    text = re.sub(r\"[^a-z\\s]\", \" \", text)\n",
    "    return re.sub(r\"\\s+\", \" \", text).strip()\n",
    "\n",
    "df[\"clean_text\"] = df[\"Abstract\"].apply(clean)\n",
    "df = df[df[\"clean_text\"].str.len() > 30]\n",
    "\n",
    "print(df.head())\n",
    "print(df.shape)\n",
    "print(df[\"Label\"].value_counts())"
   ]
