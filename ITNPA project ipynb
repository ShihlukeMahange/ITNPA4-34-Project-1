    "import zipfile\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "# Read the research articles\n",
    "with zipfile.ZipFile(\"research_corpus.zip\") as folder:\n",
    "    files = sorted(\n",
    "        name for name in folder.namelist()\n",
    "        if name.endswith(\".txt\")\n",
    "    )\n",
    "\n",
    "    articles = [\n",
    "        (Path(name).stem, folder.read(name).decode(\n",
    "            \"utf-8\", errors=\"replace\"\n",
    "        ))\n",
    "        for name in files\n",
    "    ]\n",
    "\n",
    "# Create dataframe\n",
    "df_articles = pd.DataFrame(\n",
    "    articles, columns=[\"article\", \"content\"]\n",
    ")\n",
    "\n",
    "print(df_articles.head())\n",
    "print(\"Total articles:\", len(df_articles))"
